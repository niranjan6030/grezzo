# ---------------------------------------------------------------------
# Development defaults. Loaded ONLY by `next dev` — never by a production
# build — so nothing here can leak into a deployment.
#
# .env.local overrides every value below, so put real keys there.
# ---------------------------------------------------------------------

# Opens /admin locally. Set a real one in production via your host's
# environment variables.
ADMIN_PASSWORD=grezzo-dev-console

# --- Firebase Auth emulator ------------------------------------------
# Runs the entire sign-in flow with no Firebase account at all:
#   npm run emulator
# `demo-` project ids are reserved by Firebase for exactly this.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-grezzo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-grezzo
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demogrezzo
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_PROJECT_ID=demo-grezzo

# --- Razorpay ---------------------------------------------------------
# A secret with no key id: enough to exercise signature verification
# (`npm run test:razorpay`) while the order route still reports itself
# as not configured, which is the truth.
RAZORPAY_KEY_SECRET=local_signature_test_secret
# Local-only, so the webhook signature path can be exercised without a
# Razorpay account. Production reads the real secret from the host.
RAZORPAY_WEBHOOK_SECRET=local_webhook_test_secret
