# ---------------------------------------------------------------------
# GREZZO — environment
# Copy to .env.local and fill in what you have. Everything is optional:
# the storefront runs with none of it, and each service switches on as
# soon as its keys appear.
# ---------------------------------------------------------------------

# --- Site address ----------------------------------------------------
# Absolute URL of this deployment. Used for canonical links, Open Graph
# images, sitemap.xml and robots.txt. On Vercel this is inferred from the
# project URL, so set it only once a real domain is attached.
NEXT_PUBLIC_SITE_URL=https://grezzojeans.com
NEXT_PUBLIC_SUPPORT_EMAIL=help@grezzojeans.com

# --- Admin console -------------------------------------------------
# Required to open /admin. Choose something long.
ADMIN_PASSWORD=
# Optional. Signs the admin session cookie; defaults to ADMIN_PASSWORD.
# Set it so rotating the password does not invalidate every session.
ADMIN_SESSION_SECRET=

# --- Firebase Authentication ---------------------------------------
# Firebase console → Project settings → General → Your apps → Web app.
# These are public by design; Firebase security comes from the rules and
# the authorised-domains list, not from hiding the config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only — verifies session cookies and gates cash on delivery.
# Project settings → Service accounts → Generate new private key.
# Either paste the whole JSON on one line:
FIREBASE_SERVICE_ACCOUNT=
# …or set the three fields separately (keep the \n sequences in the key):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Supabase (database) -------------------------------------------
# Project settings → API. Identity is Firebase's job; Supabase stores data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security — never expose this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (payments) -------------------------------------------
# Dashboard → Settings → API Keys. Use test keys until you go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks. Needed for payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# --- AI service (LSTM recommender + CLIP lens) ---------------------
# The FastAPI service in ../ai. Without it the site uses its built-in
# hybrid recommender and on-device colour matching.
AI_SERVICE_URL=
